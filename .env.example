# Copy this file to .env and fill in the values. Never commit .env.

# Hugging Face token. Type "Write" if you upload checkpoints to the team's private model repo
# (#8); "Read" is enough to download them. Needed for the gated Llama 3.2 model.
HF_TOKEN=

# Modal token, from `modal token new` or https://modal.com/settings/tokens
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional: absolute path to the dataset/ folder of a 3W checkout at commit
# c86cc7c70063646910be7292de8a54a6fb2a8399 (only for --source parquet and the exploration script)
THREEW_DATASET_DIR=
